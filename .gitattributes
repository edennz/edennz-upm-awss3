# Prefer Unix line-endings for these file types:
*.cs text eol=lf

# We want Unix line-endings even on Windows, so that bash works on all platforms.
*.sh text eol=lf

# Keep bat files CRLF
*.bat text eol=crlf

# Archives
*.zip filter=lfs diff=lfs merge=lfs binary
*.gz filter=lfs diff=lfs merge=lfs binary
*.bz2 filter=lfs diff=lfs merge=lfs binary
*.tgz filter=lfs diff=lfs merge=lfs binary
*.unitypackage filter=lfs diff=lfs merge=lfs binary

# Libraries.
*.a filter=lfs diff=lfs merge=lfs binary
*.so filter=lfs diff=lfs merge=lfs binary
*.lib filter=lfs diff=lfs merge=lfs binary
*.dylib filter=lfs diff=lfs merge=lfs binary
*.dll filter=lfs diff=lfs merge=lfs binary
*.dll.debug filter=lfs diff=lfs merge=lfs binary
*.pdb filter=lfs diff=lfs merge=lfs binary
*.pdb.debug filter=lfs diff=lfs merge=lfs binary
*.exe filter=lfs diff=lfs merge=lfs binary
*.aar filter=lfs diff=lfs merge=lfs binary
*.jar filter=lfs diff=lfs merge=lfs binary
# Note that Mac OS bundles can be either a Mach-O bundle file, OR a bundle folder hierachy.
*.bundle binary
**/_CodeSignature/CodeResources binary

# Models
*.fbx filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs binary

# Images.
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.svg binary

# Fonts
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text

# Other binary resources.
*.db binary